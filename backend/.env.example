GITHUB_TOKEN=
DEBUG=false
JWT_SECRET_KEY=change-me-in-production
SEED_USERS=[{"username":"admin","password":"changeme","role":"admin"}]

# Mark the session cookie Secure. Keep false for local HTTP development.
COOKIE_SECURE=false

# Current release cycle. Without BOTH of these every package is reported with
# an "unknown" status and the milestone timeline comes back empty.
# Number of the tracking issue in rocq-prover/platform listing the packages
# to update. Change it at the start of each cycle.
TRACKING_ISSUE_NUMBER=
# Validation deadline, ISO format. Past this date "waiting" becomes "blocked".
RELEASE_DEADLINE=

# Defaults match infra/docker-compose.yml; override only if needed.
# MONGO_URL=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379/0
